# Copy to .env (not versioned) and adjust.

# Folder with the photos and clips (mounted read-only). Development PC: synthetic media only.
MEDIA_DIR=./dev-media
# Folder with the background music (mounted read-only).
MUSIC_DIR=./music
# Working folder (output, cache, temporary files).
WORK_DIR=./work

# Host user, from `id -u` and `id -g` (the example values must be replaced).
HOST_UID=1000
HOST_GID=1000

# Compose files in use. The Intel GPU override is active by default; remove it on machines without /dev/dri.
# Add compose.selinux.yaml only on hosts with SELinux.
COMPOSE_FILE=compose.yaml:compose.intel-gpu.yaml

# Vision model (default defined in compose.yaml).
# OLLAMA_MODEL=qwen3-vl:4b-instruct-q4_K_M

# Set to 0 to disable Vulkan in Ollama (CPU-versus-GPU benchmarks, unstable iGPUs).
# OLLAMA_VULKAN=0

# Time zone for the mtime fallback, e.g. Europe/Rome.
# ASSUME_TZ=

# Version written in the image label.
# APP_VERSION=
